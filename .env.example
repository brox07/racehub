# --- Postgres ---
POSTGRES_USER=racehub
POSTGRES_PASSWORD=change-me-in-prod
POSTGRES_DB=racehub
DB_PORT=5432

# Connection string used by web + worker.
# Inside Docker the host is "db"; for local (host) dev use localhost.
DATABASE_URL=postgres://racehub:change-me-in-prod@db:5432/racehub
# Local host dev override:
# DATABASE_URL=postgres://racehub:change-me-in-prod@localhost:5432/racehub

# --- Web / Auth.js ---
WEB_PORT=3000
# Generate with: openssl rand -base64 32
AUTH_SECRET=
NEXT_PUBLIC_SITE_NAME=RaceHub
# Comma-separated emails granted access to /admin (e.g. you@example.com).
ADMIN_EMAILS=

# --- Worker / AI news (OpenRouter) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-haiku
# Cron schedules (UTC). Defaults: ingest schedules every 6h, refresh news hourly.
INGEST_CRON=0 */6 * * *
NEWS_CRON=0 * * * *

# --- Cloudflare Tunnel ---
CLOUDFLARE_TUNNEL_TOKEN=

